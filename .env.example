# Talkive Environment Variables Template

# Application
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/talkive

# Redis (Caching, Rate Limiting, PubSub)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_32chars_min
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_32chars_min
COOKIE_SECRET=dev_cookie_signing_secret_super_secure_32chars

# LiveKit SFU (Real-Time WebRTC Media)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretdevkey123456789talkive

# S3 / Cloudflare R2 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET_NAME=talkive-recordings
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=miniopassword
S3_PUBLIC_URL=http://localhost:9000/talkive-recordings

# Deepgram (Streaming Speech-to-Text)
DEEPGRAM_API_KEY=

# LLM Providers (Post-meeting summaries & Visual Notes)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
