{
  "name": "@talkive/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@talkive/config-typescript": "workspace:*",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  }
}
